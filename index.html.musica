<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SoulWave · Ouça e Baixe Músicas</title>
  <!-- Font Awesome para ícones -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    /* Reset e base */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    body {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: #0a0a0f;
      background-image: 
        radial-gradient(ellipse at 20% 50%, rgba(40, 20, 80, 0.3) 0%, transparent 60%),
        radial-gradient(ellipse at 80% 50%, rgba(20, 40, 80, 0.3) 0%, transparent 60%),
        linear-gradient(180deg, #0a0a0f 0%, #141420 100%);
      padding: 1.5rem;
    }

    /* Container principal - estilo vidro fosco com borda neon */
    .music-app {
      max-width: 900px;
      width: 100%;
      background: rgba(16, 16, 28, 0.75);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-radius: 2rem;
      padding: 2rem 2.2rem;
      border: 1px solid rgba(255, 255, 255, 0.06);
      box-shadow: 
        0 30px 60px -20px rgba(0, 0, 0, 0.9),
        inset 0 1px 0 rgba(255, 255, 255, 0.05),
        0 0 80px rgba(100, 70, 200, 0.08);
      transition: all 0.3s ease;
    }

    /* Cabeçalho com logo e ações */
    .app-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
      flex-wrap: wrap;
      gap: 0.8rem;
    }

    .logo-area {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .logo-area .logo-icon {
      width: 42px;
      height: 42px;
      background: linear-gradient(135deg, #7c4dff, #b388ff);
      border-radius: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
      color: #fff;
      box-shadow: 0 4px 15px rgba(124, 77, 255, 0.3);
    }

    .logo-area h1 {
      color: #f0f0ff;
      font-weight: 700;
      font-size: 1.6rem;
      letter-spacing: -0.5px;
    }

    .logo-area h1 span {
      color: #b388ff;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 0.8rem;
    }

    .header-actions .badge {
      background: rgba(124, 77, 255, 0.15);
      padding: 0.4rem 1rem;
      border-radius: 30px;
      color: #c9b0ff;
      font-size: 0.8rem;
      border: 1px solid rgba(124, 77, 255, 0.15);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .header-actions .btn-download-header {
      background: linear-gradient(135deg, #7c4dff, #b388ff);
      border: none;
      color: #fff;
      padding: 0.5rem 1.2rem;
      border-radius: 30px;
      font-weight: 600;
      font-size: 0.85rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s;
      box-shadow: 0 4px 15px rgba(124, 77, 255, 0.25);
    }

    .header-actions .btn-download-header:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 25px rgba(124, 77, 255, 0.4);
    }

    /* Player principal - destaque */
    .player-card {
      background: rgba(10, 10, 20, 0.5);
      border-radius: 1.5rem;
      padding: 1.8rem;
      border: 1px solid rgba(255, 255, 255, 0.04);
      margin-bottom: 2rem;
      position: relative;
      overflow: hidden;
    }

    .player-card::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -20%;
      width: 300px;
      height: 300px;
      background: radial-gradient(circle, rgba(124, 77, 255, 0.06), transparent 70%);
      pointer-events: none;
      border-radius: 50%;
    }

    .now-playing {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      flex-wrap: wrap;
      position: relative;
      z-index: 1;
    }

    .cover-art {
      width: 85px;
      height: 85px;
      border-radius: 18px;
      background: linear-gradient(135deg, #2a1a4a, #1a1a2e);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.8rem;
      box-shadow: 0 8px 25px rgba(0, 0, 0, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.06);
      flex-shrink: 0;
      transition: 0.3s;
    }

    .cover-art:hover {
      transform: scale(1.03);
    }

    .track-info {
      flex: 1;
      min-width: 160px;
    }

    .track-info .title {
      color: #f0f0ff;
      font-weight: 700;
      font-size: 1.4rem;
      letter-spacing: -0.3px;
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .track-info .title .fav {
      color: #ff6b9d;
      font-size: 0.9rem;
      opacity: 0.9;
    }

    .track-info .artist {
      color: #9aa4c4;
      font-size: 0.95rem;
      margin-top: 4px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .track-info .artist i {
      color: #5f6b89;
      font-size: 0.7rem;
    }

    .track-info .meta-tags {
      display: flex;
      gap: 0.6rem;
      margin-top: 0.5rem;
      flex-wrap: wrap;
    }

    .track-info .meta-tags span {
      background: rgba(255, 255, 255, 0.04);
      padding: 0.15rem 0.8rem;
      border-radius: 20px;
      font-size: 0.7rem;
      color: #7a86a8;
      border: 1px solid rgba(255, 255, 255, 0.04);
    }

    /* Controles do player */
    .player-controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 1.5rem;
      gap: 1rem;
      flex-wrap: wrap;
      position: relative;
      z-index: 1;
    }

    .control-buttons {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .control-buttons button {
      background: transparent;
      border: none;
      color: #9aa4c4;
      font-size: 1.2rem;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s;
      cursor: pointer;
      background: rgba(255, 255, 255, 0.02);
    }

    .control-buttons button:hover {
      background: rgba(124, 77, 255, 0.1);
      color: #d4ccff;
      transform: scale(1.05);
    }

    .control-buttons .play-btn {
      background: linear-gradient(135deg, #7c4dff, #b388ff);
      color: #fff;
      width: 54px;
      height: 54px;
      font-size: 1.5rem;
      box-shadow: 0 6px 20px rgba(124, 77, 255, 0.3);
    }

    .control-buttons .play-btn:hover {
      transform: scale(1.06);
      box-shadow: 0 8px 30px rgba(124, 77, 255, 0.45);
    }

    .progress-area {
      flex: 2;
      min-width: 160px;
      display: flex;
      align-items: center;
      gap: 0.8rem;
    }

    .progress-area span {
      color: #7a86a8;
      font-size: 0.8rem;
      font-weight: 500;
    }

    .progress-bar {
      flex: 1;
      height: 4px;
      background: #2a2a3e;
      border-radius: 10px;
      cursor: pointer;
      position: relative;
    }

    .progress-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #7c4dff, #b388ff);
      border-radius: 10px;
      transition: width 0.1s linear;
      box-shadow: 0 0 12px rgba(124, 77, 255, 0.3);
    }

    /* Botão de download na área do player */
    .download-track-btn {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.06);
      color: #b0b8d8;
      padding: 0.5rem 1.2rem;
      border-radius: 30px;
      font-size: 0.8rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s;
    }

    .download-track-btn:hover {
      background: rgba(124, 77, 255, 0.12);
      border-color: rgba(124, 77, 255, 0.2);
      color: #d4ccff;
    }

    /* Playlist */
    .playlist-section {
      margin-top: 0.5rem;
    }

    .playlist-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .playlist-header h3 {
      color: #d3dcef;
      font-weight: 600;
      font-size: 1rem;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .playlist-header h3 i {
      color: #b388ff;
    }

    .playlist-header .count {
      background: #1a1a2e;
      padding: 0.25rem 1rem;
      border-radius: 30px;
      color: #9aa4c4;
      font-size: 0.75rem;
      border: 1px solid rgba(255, 255, 255, 0.04);
    }

    .playlist-items {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      max-height: 360px;
      overflow-y: auto;
      padding-right: 4px;
    }

    .playlist-items::-webkit-scrollbar {
      width: 3px;
    }

    .playlist-items::-webkit-scrollbar-track {
      background: #14141f;
      border-radius: 10px;
    }

    .playlist-items::-webkit-scrollbar-thumb {
      background: #4a4a6a;
      border-radius: 10px;
    }

    .track-item {
      display: flex;
      align-items: center;
      padding: 0.7rem 1rem;
      border-radius: 1rem;
      background: rgba(255, 255, 255, 0.015);
      border: 1px solid transparent;
      transition: all 0.2s;
      cursor: pointer;
      gap: 1rem;
    }

    .track-item:hover {
      background: rgba(124, 77, 255, 0.05);
      border-color: rgba(124, 77, 255, 0.06);
    }

    .track-item.active {
      background: rgba(124, 77, 255, 0.08);
      border-color: rgba(124, 77, 255, 0.12);
    }

    .track-item .index {
      color: #5a5a7a;
      font-weight: 500;
      font-size: 0.75rem;
      width: 22px;
      text-align: center;
    }

    .track-item .info {
      flex: 1;
    }

    .track-item .info .name {
      color: #eef2fc;
      font-weight: 500;
      font-size: 0.95rem;
    }

    .track-item .info .artist-name {
      color: #7a86a8;
      font-size: 0.75rem;
    }

    .track-item .duration {
      color: #5a5a7a;
      font-size: 0.75rem;
      background: #14141f;
      padding: 0.15rem 0.7rem;
      border-radius: 30px;
    }

    .track-item .actions {
      display: flex;
      gap: 0.4rem;
      align-items: center;
    }

    .track-item .actions button {
      background: transparent;
      border: none;
      color: #5a5a7a;
      font-size: 0.85rem;
      cursor: pointer;
      padding: 4px 6px;
      border-radius: 8px;
      transition: all 0.2s;
      opacity: 0;
    }

    .track-item:hover .actions button {
      opacity: 1;
    }

    .track-item .actions button:hover {
      color: #b388ff;
      background: rgba(124, 77, 255, 0.08);
    }

    .track-item.active .actions button {
      opacity: 1;
    }

    .track-item .play-indicator {
      color: #b388ff;
      font-size: 0.9rem;
      opacity: 0;
      transition: 0.2s;
    }

    .track-item.active .play-indicator {
      opacity: 1;
    }

    /* Rodapé com botão de download geral */
    .footer-actions {
      margin-top: 1.5rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-top: 1px solid rgba(255, 255, 255, 0.03);
      padding-top: 1.2rem;
      flex-wrap: wrap;
      gap: 0.8rem;
    }

    .footer-actions .left-actions {
      display: flex;
      gap: 1.5rem;
      color: #5a5a7a;
      font-size: 0.8rem;
    }

    .footer-actions .left-actions i {
      margin-right: 6px;
      color: #6a6a8a;
    }

    .btn-download-all {
      background: linear-gradient(135deg, #7c4dff, #b388ff);
      border: none;
      color: #fff;
      padding: 0.5rem 1.5rem;
      border-radius: 30px;
      font-weight: 600;
      font-size: 0.85rem;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s;
      box-shadow: 0 4px 15px rgba(124, 77, 255, 0.2);
    }

    .btn-download-all:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 25px rgba(124, 77, 255, 0.35);
    }

    /* Responsivo */
    @media (max-width: 640px) {
      .music-app {
        padding: 1.2rem;
      }
      .now-playing {
        flex-direction: column;
        align-items: flex-start;
      }
      .player-controls {
        flex-direction: column;
        align-items: stretch;
      }
      .control-buttons {
        justify-content: center;
      }
      .progress-area {
        width: 100%;
      }
      .track-item {
        padding: 0.5rem 0.7rem;
        flex-wrap: wrap;
      }
      .track-item .actions button {
        opacity: 1;
      }
      .header-actions .btn-download-header span {
        display: none;
      }
      .footer-actions {
        flex-direction: column;
        align-items: stretch;
      }
      .btn-download-all {
        justify-content: center;
      }
    }
  </style>
</head>
<body>

<div class="music-app">
  <!-- Cabeçalho -->
  <div class="app-header">
    <div class="logo-area">
      <div class="logo-icon"><i class="fas fa-waveform"></i></div>
      <h1>Soul<span>Wave</span></h1>
    </div>
    <div class="header-actions">
      <span class="badge"><i class="fas fa-music"></i> 6 faixas</span>
      <button class="btn-download-header" id="downloadAllBtn">
        <i class="fas fa-download"></i> <span>Baixar tudo</span>
      </button>
    </div>
  </div>

  <!-- Player -->
  <div class="player-card">
    <div class="now-playing">
      <div class="cover-art" id="coverArt">
        <i class="fas fa-music"></i>
      </div>
      <div class="track-info">
        <div class="title" id="currentTitle">
          <span>Nightfall</span>
          <span class="fav"><i class="fas fa-heart"></i></span>
        </div>
        <div class="artist" id="currentArtist">
          <i class="fas fa-user-circle"></i> Aurora Lane
        </div>
        <div class="meta-tags">
          <span><i class="far fa-calendar-alt"></i> 2025</span>
          <span><i class="fas fa-tag"></i> Electronic</span>
        </div>
      </div>
    </div>

    <div class="player-controls">
      <div class="control-buttons">
        <button id="prevBtn"><i class="fas fa-step-backward"></i></button>
        <button class="play-btn" id="playBtn"><i class="fas fa-play"></i></button>
        <button id="nextBtn"><i class="fas fa-step-forward"></i></button>
      </div>
      <div class="progress-area">
        <span id="currentTime">0:00</span>
        <div class="progress-bar" id="progressBar">
          <div class="progress-fill" id="progressFill"></div>
        </div>
        <span id="totalDuration">3:24</span>
      </div>
      <button class="download-track-btn" id="downloadTrackBtn">
        <i class="fas fa-download"></i> Baixar
      </button>
    </div>
  </div>

  <!-- Playlist -->
  <div class="playlist-section">
    <div class="playlist-header">
      <h3><i class="fas fa-list-ul"></i> Playlist · Vibes</h3>
      <span class="count"><i class="far fa-clock"></i> 21 min</span>
    </div>
    <div class="playlist-items" id="playlistContainer">
      <!-- Itens inseridos via JS -->
    </div>
  </div>

  <!-- Rodapé -->
  <div class="footer-actions">
    <div class="left-actions">
      <span><i class="fas fa-shuffle"></i> Aleatório</span>
      <span><i class="fas fa-repeat"></i> Repetir</span>
      <span><i class="fas fa-download"></i> Qualidade: 320kbps</span>
    </div>
    <button class="btn-download-all" id="downloadAllBtnFooter">
      <i class="fas fa-download"></i> Baixar playlist completa
    </button>
  </div>
</div>

<script>
  (function() {
    // ---------- PLAYLIST ----------
    const playlist = [
      { id: 0, title: 'Nightfall', artist: 'Aurora Lane', duration: '3:24', cover: '🌙' },
      { id: 1, title: 'Echoes', artist: 'Mira Solis', duration: '4:12', cover: '🌊' },
      { id: 2, title: 'Velvet Dreams', artist: 'Noir & Ivory', duration: '3:48', cover: '🌆' },
      { id: 3, title: 'Pulse', artist: 'Neon Grid', duration: '2:59', cover: '⚡' },
      { id: 4, title: 'Solstice', artist: 'Aurora Lane', duration: '4:01', cover: '☀️' },
      { id: 5, title: 'Lunar Tide', artist: 'Stellar Drift', duration: '3:36', cover: '🌊' }
    ];

    // ---------- DOM ----------
    const container = document.getElementById('playlistContainer');
    const playBtn = document.getElementById('playBtn');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const progressFill = document.getElementById('progressFill');
    const progressBar = document.getElementById('progressBar');
    const currentTimeSpan = document.getElementById('currentTime');
    const totalDurationSpan = document.getElementById('totalDuration');
    const currentTitle = document.getElementById('currentTitle');
    const currentArtist = document.getElementById('currentArtist');
    const coverArt = document.getElementById('coverArt');
    const downloadTrackBtn = document.getElementById('downloadTrackBtn');
    const downloadAllBtn = document.getElementById('downloadAllBtn');
    const downloadAllBtnFooter = document.getElementById('downloadAllBtnFooter');

    // ---------- ESTADO ----------
    let currentIndex = 0;
    let isPlaying = false;
    let progress = 0;
    let intervalId = null;

    // ---------- FUNÇÕES ----------
    function formatTime(seconds) {
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
    }

    function updateTrackUI(index) {
      const track = playlist[index];
      if (!track) return;
      currentTitle.innerHTML = `<span>${track.title}</span> <span class="fav"><i class="fas fa-heart"></i></span>`;
      currentArtist.innerHTML = `<i class="fas fa-user-circle"></i> ${track.artist}`;
      coverArt.innerHTML = `<span style="font-size:2.6rem;">${track.cover || '🎵'}</span>`;
      totalDurationSpan.textContent = track.duration;

      document.querySelectorAll('.track-item').forEach((el, idx) => {
        el.classList.toggle('active', idx === index);
      });

      const activeItem = document.querySelector('.track-item.active');
      if (activeItem) {
        activeItem.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    }

    function loadTrack(index) {
      if (index < 0) index = 0;
      if (index >= playlist.length) index = playlist.length - 1;
      currentIndex = index;
      progress = 0;
      progressFill.style.width = '0%';
      currentTimeSpan.textContent = '0:00';
      updateTrackUI(currentIndex);
      if (isPlaying) {
        clearInterval(intervalId);
        startProgress();
      } else {
        if (intervalId) clearInterval(intervalId);
        intervalId = null;
      }
      playBtn.innerHTML = isPlaying ? '<i class="fas fa-pause"></i>' : '<i class="fas fa-play"></i>';
    }

    function startProgress() {
      if (intervalId) clearInterval(intervalId);
      intervalId = setInterval(() => {
        if (progress >= 100) {
          clearInterval(intervalId);
          intervalId = null;
          isPlaying = false;
          playBtn.innerHTML = '<i class="fas fa-play"></i>';
          const next = (currentIndex + 1) % playlist.length;
          loadTrack(next);
          if (currentIndex === playlist.length - 1) {
            isPlaying = false;
            playBtn.innerHTML = '<i class="fas fa-play"></i>';
            progress = 0;
            progressFill.style.width = '0%';
            currentTimeSpan.textContent = '0:00';
            return;
          }
          isPlaying = true;
          playBtn.innerHTML = '<i class="fas fa-pause"></i>';
          progress = 0;
          progressFill.style.width = '0%';
          currentTimeSpan.textContent = '0:00';
          startProgress();
          return;
        }
        progress += 1.2;
        if (progress > 100) progress = 100;
        progressFill.style.width = progress + '%';
        const totalSecs = 204;
        const currentSecs = (progress / 100) * totalSecs;
        currentTimeSpan.textContent = formatTime(currentSecs);
      }, 300);
    }

    function togglePlay() {
      if (isPlaying) {
        clearInterval(intervalId);
        intervalId = null;
        isPlaying = false;
        playBtn.innerHTML = '<i class="fas fa-play"></i>';
      } else {
        isPlaying = true;
        playBtn.innerHTML = '<i class="fas fa-pause"></i>';
        if (progress >= 100) {
          progress = 0;
          progressFill.style.width = '0%';
          currentTimeSpan.textContent = '0:00';
        }
        startProgress();
      }
    }

    function nextTrack() {
      const nextIndex = (currentIndex + 1) % playlist.length;
      if (intervalId) { clearInterval(intervalId); intervalId = null; }
      isPlaying = false;
      playBtn.innerHTML = '<i class="fas fa-play"></i>';
      loadTrack(nextIndex);
    }

    function prevTrack() {
      const prevIndex = (currentIndex - 1 + playlist.length) % playlist.length;
      if (intervalId) { clearInterval(intervalId); intervalId = null; }
      isPlaying = false;
      playBtn.innerHTML = '<i class="fas fa-play"></i>';
      loadTrack(prevIndex);
    }

    // ---------- SIMULAÇÃO DE DOWNLOAD ----------
    function downloadTrack(index) {
      const track = playlist[index];
      alert(`⬇️ Baixando "${track.title}" - ${track.artist} (320kbps)`);
    }

    function downloadAllTracks() {
      const names = playlist.map(t => `"${t.title}"`).join(', ');
      alert(`⬇️ Baixando playlist completa: ${names}`);
    }

    // ---------- RENDERIZAR PLAYLIST ----------
    function renderPlaylist() {
      container.innerHTML = '';
      playlist.forEach((track, index) => {
        const item = document.createElement('div');
        item.className = `track-item ${index === currentIndex ? 'active' : ''}`;
        item.dataset.index = index;

        item.innerHTML = `
          <span class="index">${String(index + 1).padStart(2, '0')}</span>
          <div class="info">
            <div class="name">${track.title}</div>
            <div class="artist-name">${track.artist}</div>
          </div>
          <span class="duration">${track.duration}</span>
          <span class="play-indicator"><i class="fas fa-play-circle"></i></span>
          <div class="actions">
            <button class="download-item-btn" title="Baixar"><i class="fas fa-download"></i></button>
          </div>
        `;

        // Clique na faixa -> tocar
        item.addEventListener('click', function(e) {
          if (e.target.closest('.download-item-btn')) return;
          const idx = parseInt(this.dataset.index);
          if (intervalId) { clearInterval(intervalId); intervalId = null; }
          isPlaying = false;
          playBtn.innerHTML = '<i class="fas fa-play"></i>';
          loadTrack(idx);
          isPlaying = true;
          playBtn.innerHTML = '<i class="fas fa-pause"></i>';
          progress = 0;
          progressFill.style.width = '0%';
          currentTimeSpan.textContent = '0:00';
          startProgress();
        });

        // Botão de download individual na playlist
        const downloadBtn = item.querySelector('.download-item-btn');
        downloadBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          downloadTrack(index);
        });

        container.appendChild(item);
      });
    }

    // ---------- EVENTOS ----------
    playBtn.addEventListener('click', togglePlay);
    nextBtn.addEventListener('click', nextTrack);
    prevBtn.addEventListener('click', prevTrack);

    progressBar.addEventListener('click', function(e) {
      const rect = this.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const percent = (clickX / rect.width) * 100;
      progress = Math.min(100, Math.max(0, percent));
      progressFill.style.width = progress + '%';
      const totalSecs = 204;
      const currentSecs = (progress / 100) * totalSecs;
      currentTimeSpan.textContent = formatTime(currentSecs);
    });

    // Download do botão no player
    downloadTrackBtn.addEventListener('click', function() {
      downloadTrack(currentIndex);
    });

    // Downloads dos botões de "baixar tudo"
    downloadAllBtn.addEventListener('click', downloadAllTracks);
    downloadAllBtnFooter.addEventListener('click', downloadAllTracks);

    // ---------- INICIALIZAÇÃO ----------
    function init() {
      renderPlaylist();
      loadTrack(0);
      isPlaying = false;
      playBtn.innerHTML = '<i class="fas fa-play"></i>';
      if (intervalId) { clearInterval(intervalId); intervalId = null; }
      progress = 0;
      progressFill.style.width = '0%';
      currentTimeSpan.textContent = '0:00';
      updateTrackUI(0);
    }

    init();

    // Tecla espaço
    document.addEventListener('keydown', (e) => {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
      if (e.code === 'Space') {
        e.preventDefault();
        togglePlay();
      }
    });

  })();
</script>
</body>
</html>