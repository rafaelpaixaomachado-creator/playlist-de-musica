<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SoulWave · Player de Música</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    body {
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: #0d0d1a;
      background: radial-gradient(ellipse at center, #1a1a2e 0%, #0d0d1a 100%);
      padding: 20px;
    }

    /* Container Principal */
    .player-container {
      max-width: 1000px;
      width: 100%;
      background: rgba(255, 255, 255, 0.03);
      backdrop-filter: blur(30px);
      border-radius: 30px;
      padding: 30px 35px;
      border: 1px solid rgba(255, 255, 255, 0.05);
      box-shadow: 0 40px 80px rgba(0, 0, 0, 0.8);
    }

    /* Topo */
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
      flex-wrap: wrap;
      gap: 15px;
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .logo-icon {
      width: 45px;
      height: 45px;
      background: linear-gradient(135deg, #6C3CE1, #A78BFA);
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      color: white;
    }

    .logo h1 {
      color: #fff;
      font-size: 26px;
      font-weight: 700;
      letter-spacing: -0.5px;
    }

    .logo h1 span {
      color: #A78BFA;
    }

    .top-actions {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .top-actions .playlist-info {
      color: #8888aa;
      font-size: 14px;
      background: rgba(255, 255, 255, 0.05);
      padding: 8px 16px;
      border-radius: 20px;
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .btn-download {
      background: linear-gradient(135deg, #6C3CE1, #A78BFA);
      border: none;
      color: #fff;
      padding: 10px 20px;
      border-radius: 25px;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.3s;
    }

    .btn-download:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(108, 60, 225, 0.4);
    }

    /* Player */
    .player-main {
      background: rgba(255, 255, 255, 0.02);
      border-radius: 20px;
      padding: 25px;
      border: 1px solid rgba(255, 255, 255, 0.04);
      margin-bottom: 25px;
    }

    .track-display {
      display: flex;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }

    .cover {
      width: 90px;
      height: 90px;
      border-radius: 18px;
      background: linear-gradient(135deg, #2a1a4a, #1a1a2e);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 40px;
      border: 1px solid rgba(255, 255, 255, 0.05);
      flex-shrink: 0;
    }

    .track-details {
      flex: 1;
      min-width: 180px;
    }

    .track-details .title {
      color: #fff;
      font-size: 22px;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .track-details .title .heart {
      color: #ff6b9d;
      font-size: 16px;
    }

    .track-details .artist {
      color: #9999bb;
      font-size: 15px;
      margin-top: 4px;
    }

    .track-details .tags {
      display: flex;
      gap: 8px;
      margin-top: 8px;
      flex-wrap: wrap;
    }

    .track-details .tags span {
      background: rgba(255, 255, 255, 0.04);
      padding: 3px 12px;
      border-radius: 12px;
      font-size: 11px;
      color: #7777aa;
      border: 1px solid rgba(255, 255, 255, 0.04);
    }

    /* Controles */
    .controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 20px;
      gap: 15px;
      flex-wrap: wrap;
    }

    .controls-buttons {
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .controls-buttons button {
      background: transparent;
      border: none;
      color: #8888bb;
      width: 40px;
      height: 40px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 18px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .controls-buttons button:hover {
      background: rgba(167, 139, 250, 0.1);
      color: #fff;
    }

    .controls-buttons .play-btn {
      background: linear-gradient(135deg, #6C3CE1, #A78BFA);
      color: #fff;
      width: 56px;
      height: 56px;
      font-size: 22px;
      box-shadow: 0 8px 25px rgba(108, 60, 225, 0.3);
    }

    .controls-buttons .play-btn:hover {
      transform: scale(1.05);
      box-shadow: 0 8px 30px rgba(108, 60, 225, 0.5);
    }

    .progress-section {
      flex: 2;
      min-width: 180px;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .progress-section span {
      color: #7777aa;
      font-size: 13px;
      font-weight: 500;
    }

    .progress-bar {
      flex: 1;
      height: 4px;
      background: #2a2a3e;
      border-radius: 10px;
      cursor: pointer;
      position: relative;
    }

    .progress-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #6C3CE1, #A78BFA);
      border-radius: 10px;
      transition: width 0.1s;
      box-shadow: 0 0 15px rgba(108, 60, 225, 0.3);
    }

    .btn-download-track {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.05);
      color: #9999bb;
      padding: 8px 18px;
      border-radius: 25px;
      font-size: 13px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s;
    }

    .btn-download-track:hover {
      background: rgba(108, 60, 225, 0.1);
      border-color: rgba(108, 60, 225, 0.2);
      color: #fff;
    }

    /* Playlist */
    .playlist-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 15px;
      flex-wrap: wrap;
      gap: 10px;
    }

    .playlist-header h3 {
      color: #ddddff;
      font-size: 16px;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .playlist-header h3 i {
      color: #A78BFA;
    }

    .playlist-header .count {
      color: #8888bb;
      font-size: 13px;
      background: rgba(255, 255, 255, 0.03);
      padding: 4px 14px;
      border-radius: 15px;
      border: 1px solid rgba(255, 255, 255, 0.03);
    }

    .playlist {
      display: flex;
      flex-direction: column;
      gap: 4px;
      max-height: 350px;
      overflow-y: auto;
      padding-right: 5px;
    }

    .playlist::-webkit-scrollbar {
      width: 3px;
    }

    .playlist::-webkit-scrollbar-track {
      background: transparent;
    }

    .playlist::-webkit-scrollbar-thumb {
      background: #3a3a5a;
      border-radius: 10px;
    }

    .track-item {
      display: flex;
      align-items: center;
      padding: 10px 14px;
      border-radius: 14px;
      background: transparent;
      border: 1px solid transparent;
      transition: all 0.2s;
      cursor: pointer;
      gap: 12px;
    }

    .track-item:hover {
      background: rgba(167, 139, 250, 0.04);
      border-color: rgba(167, 139, 250, 0.06);
    }

    .track-item.active {
      background: rgba(167, 139, 250, 0.06);
      border-color: rgba(167, 139, 250, 0.1);
    }

    .track-item .num {
      color: #555577;
      font-size: 13px;
      font-weight: 500;
      width: 28px;
      text-align: center;
    }

    .track-item .info {
      flex: 1;
    }

    .track-item .info .name {
      color: #eeeefc;
      font-weight: 500;
      font-size: 15px;
    }

    .track-item .info .artist-name {
      color: #7777aa;
      font-size: 13px;
    }

    .track-item .duration {
      color: #555577;
      font-size: 13px;
      background: rgba(255, 255, 255, 0.02);
      padding: 2px 10px;
      border-radius: 12px;
    }

    .track-item .actions {
      display: flex;
      gap: 6px;
      opacity: 0;
      transition: all 0.2s;
    }

    .track-item:hover .actions {
      opacity: 1;
    }

    .track-item.active .actions {
      opacity: 1;
    }

    .track-item .actions button {
      background: transparent;
      border: none;
      color: #555577;
      font-size: 14px;
      cursor: pointer;
      padding: 4px 6px;
      border-radius: 6px;
      transition: all 0.2s;
    }

    .track-item .actions button:hover {
      color: #A78BFA;
      background: rgba(167, 139, 250, 0.08);
    }

    .track-item .playing-icon {
      color: #A78BFA;
      font-size: 14px;
      opacity: 0;
      transition: 0.2s;
    }

    .track-item.active .playing-icon {
      opacity: 1;
    }

    /* Rodapé */
    .footer {
      margin-top: 20px;
      padding-top: 18px;
      border-top: 1px solid rgba(255, 255, 255, 0.03);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    .footer .left {
      display: flex;
      gap: 20px;
      color: #555577;
      font-size: 13px;
    }

    .footer .left i {
      margin-right: 5px;
      color: #666688;
    }

    .btn-download-playlist {
      background: linear-gradient(135deg, #6C3CE1, #A78BFA);
      border: none;
      color: #fff;
      padding: 8px 22px;
      border-radius: 25px;
      font-weight: 600;
      font-size: 14px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
      transition: all 0.3s;
    }

    .btn-download-playlist:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 25px rgba(108, 60, 225, 0.35);
    }

    /* Responsivo */
    @media (max-width: 700px) {
      .player-container {
        padding: 20px;
      }
      
      .track-display {
        flex-direction: column;
        align-items: flex-start;
      }
      
      .controls {
        flex-direction: column;
        align-items: stretch;
      }
      
      .controls-buttons {
        justify-content: center;
      }
      
      .progress-section {
        width: 100%;
      }
      
      .btn-download-track {
        justify-content: center;
      }
      
      .track-item {
        padding: 8px 10px;
        flex-wrap: wrap;
      }
      
      .track-item .actions {
        opacity: 1;
      }
      
      .footer {
        flex-direction: column;
        align-items: stretch;
      }
      
      .btn-download-playlist {
        justify-content: center;
      }
      
      .top-bar {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</head>
<body>

<div class="player-container">
  <!-- Topo -->
  <div class="top-bar">
    <div class="logo">
      <div class="logo-icon"><i class="fas fa-music"></i></div>
      <h1>Soul<span>Wave</span></h1>
    </div>
    <div class="top-actions">
      <span class="playlist-info"><i class="fas fa-list"></i> 6 faixas</span>
      <button class="btn-download" id="downloadAllBtn">
        <i class="fas fa-download"></i> Baixar Tudo
      </button>
    </div>
  </div>

  <!-- Player -->
  <div class="player-main">
    <div class="track-display">
      <div class="cover" id="coverArt">🎵</div>
      <div class="track-details">
        <div class="title" id="currentTitle">
          <span>Nightfall</span>
          <span class="heart"><i class="fas fa-heart"></i></span>
        </div>
        <div class="artist" id="currentArtist">Aurora Lane</div>
        <div class="tags">
          <span><i class="far fa-calendar"></i> 2025</span>
          <span><i class="fas fa-tag"></i> Electronic</span>
          <span><i class="fas fa-headphones"></i> 320kbps</span>
        </div>
      </div>
    </div>

    <div class="controls">
      <div class="controls-buttons">
        <button id="prevBtn"><i class="fas fa-step-backward"></i></button>
        <button class="play-btn" id="playBtn"><i class="fas fa-play"></i></button>
        <button id="nextBtn"><i class="fas fa-step-forward"></i></button>
      </div>
      
      <div class="progress-section">
        <span id="currentTime">0:00</span>
        <div class="progress-bar" id="progressBar">
          <div class="progress-fill" id="progressFill"></div>
        </div>
        <span id="totalDuration">3:24</span>
      </div>
      
      <button class="btn-download-track" id="downloadTrackBtn">
        <i class="fas fa-download"></i> Baixar
      </button>
    </div>
  </div>

  <!-- Playlist -->
  <div class="playlist-header">
    <h3><i class="fas fa-list-ul"></i> Playlist · Vibes</h3>
    <span class="count"><i class="far fa-clock"></i> 21 min</span>
  </div>
  
  <div class="playlist" id="playlistContainer">
    <!-- Itens via JS -->
  </div>

  <!-- Rodapé -->
  <div class="footer">
    <div class="left">
      <span><i class="fas fa-shuffle"></i> Aleatório</span>
      <span><i class="fas fa-repeat"></i> Repetir</span>
      <span><i class="fas fa-volume-up"></i> Qualidade: 320kbps</span>
    </div>
    <button class="btn-download-playlist" id="downloadAllBtnFooter">
      <i class="fas fa-download"></i> Baixar Playlist Completa
    </button>
  </div>
</div>

<script>
  (function() {
    const playlist = [
      { id: 0, title: 'Nightfall', artist: 'Aurora Lane', duration: '3:24', cover: '🌙' },
      { id: 1, title: 'Echoes', artist: 'Mira Solis', duration: '4:12', cover: '🌊' },
      { id: 2, title: 'Velvet Dreams', artist: 'Noir & Ivory', duration: '3:48', cover: '🌆' },
      { id: 3, title: 'Pulse', artist: 'Neon Grid', duration: '2:59', cover: '⚡' },
      { id: 4, title: 'Solstice', artist: 'Aurora Lane', duration: '4:01', cover: '☀️' },
      { id: 5, title: 'Lunar Tide', artist: 'Stellar Drift', duration: '3:36', cover: '🌊' }
    ];

    const container = document.getElementById('playlistContainer');
    const playBtn = document.getElementById('playBtn');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const progressFill = document.getElementById('progressFill');
    const progressBar = document.getElementById('progressBar');
    const currentTimeSpan = document.getElementById('currentTime');
    const totalDurationSpan = document.getElementById('totalDuration');
    const currentTitle = document.getElementById('currentTitle');
    const currentArtist = document.getElementById('currentArtist');
    const coverArt = document.getElementById('coverArt');
    const downloadTrackBtn = document.getElementById('downloadTrackBtn');
    const downloadAllBtn = document.getElementById('downloadAllBtn');
    const downloadAllBtnFooter = document.getElementById('downloadAllBtnFooter');

    let currentIndex = 0;
    let isPlaying = false;
    let progress = 0;
    let intervalId = null;

    function formatTime(seconds) {
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
    }

    function updateTrackUI(index) {
      const track = playlist[index];
      if (!track) return;
      currentTitle.innerHTML = `<span>${track.title}</span> <span class="heart"><i class="fas fa-heart"></i></span>`;
      currentArtist.textContent = track.artist;
      coverArt.textContent = track.cover || '🎵';
      totalDurationSpan.textContent = track.duration;

      document.querySelectorAll('.track-item').forEach((el, idx) => {
        el.classList.toggle('active', idx === index);
      });

      const activeItem = document.querySelector('.track-item.active');
      if (activeItem) {
        activeItem.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    }

    function loadTrack(index) {
      if (index < 0) index = 0;
      if (index >= playlist.length) index = playlist.length - 1;
      currentIndex = index;
      progress = 0;
      progressFill.style.width = '0%';
      currentTimeSpan.textContent = '0:00';
      updateTrackUI(currentIndex);
      if (isPlaying) {
        clearInterval(intervalId);
        startProgress();
      } else {
        if (intervalId) clearInterval(intervalId);
        intervalId = null;
      }
      playBtn.innerHTML = isPlaying ? '<i class="fas fa-pause"></i>' : '<i class="fas fa-play"></i>';
    }

    function startProgress() {
      if (intervalId) clearInterval(intervalId);
      intervalId = setInterval(() => {
        if (progress >= 100) {
          clearInterval(intervalId);
          intervalId = null;
          isPlaying = false;
          playBtn.innerHTML = '<i class="fas fa-play"></i>';
          const next = (currentIndex + 1) % playlist.length;
          loadTrack(next);
          if (currentIndex === playlist.length - 1) {
            isPlaying = false;
            playBtn.innerHTML = '<i class="fas fa-play"></i>';
            progress = 0;
            progressFill.style.width = '0%';
            currentTimeSpan.textContent = '0:00';
            return;
          }
          isPlaying = true;
          playBtn.innerHTML = '<i class="fas fa-pause"></i>';
          progress = 0;
          progressFill.style.width = '0%';
          currentTimeSpan.textContent = '0:00';
          startProgress();
          return;
        }
        progress += 1.2;
        if (progress > 100) progress = 100;
        progressFill.style.width = progress + '%';
        const totalSecs = 204;
        const currentSecs = (progress / 100) * totalSecs;
        currentTimeSpan.textContent = formatTime(currentSecs);
      }, 300);
    }

    function togglePlay() {
      if (isPlaying) {
        clearInterval(intervalId);
        intervalId = null;
        isPlaying = false;
        playBtn.innerHTML = '<i class="fas fa-play"></i>';
      } else {
        isPlaying = true;
        playBtn.innerHTML = '<i class="fas fa-pause"></i>';
        if (progress >= 100) {
          progress = 0;
          progressFill.style.width = '0%';
          currentTimeSpan.textContent = '0:00';
        }
        startProgress();
      }
    }

    function nextTrack() {
      const nextIndex = (currentIndex + 1) % playlist.length;
      if (intervalId) { clearInterval(intervalId); intervalId = null; }
      isPlaying = false;
      playBtn.innerHTML = '<i class="fas fa-play"></i>';
      loadTrack(nextIndex);
    }

    function prevTrack() {
      const prevIndex = (currentIndex - 1 + playlist.length) % playlist.length;
      if (intervalId) { clearInterval(intervalId); intervalId = null; }
      isPlaying = false;
      playBtn.innerHTML = '<i class="fas fa-play"></i>';
      loadTrack(prevIndex);
    }

    function downloadTrack(index) {
      const track = playlist[index];
      alert(`⬇️ Baixando "${track.title}" - ${track.artist} (320kbps)`);
    }

    function downloadAllTracks() {
      const names = playlist.map(t => `"${t.title}"`).join(', ');
      alert(`⬇️ Baixando playlist completa: ${names}`);
    }

    function renderPlaylist() {
      container.innerHTML = '';
      playlist.forEach((track, index) => {
        const item = document.createElement('div');
        item.className = `track-item ${index === currentIndex ? 'active' : ''}`;
        item.dataset.index = index;

        item.innerHTML = `
          <span class="num">${String(index + 1).padStart(2, '0')}</span>
          <div class="info">
            <div class="name">${track.title}</div>
            <div class="artist-name">${track.artist}</div>
          </div>
          <span class="duration">${track.duration}</span>
          <span class="playing-icon"><i class="fas fa-play-circle"></i></span>
          <div class="actions">
            <button class="download-item-btn" title="Baixar"><i class="fas fa-download"></i></button>
          </div>
        `;

        item.addEventListener('click', function(e) {
          if (e.target.closest('.download-item-btn')) return;
          const idx = parseInt(this.dataset.index);
          if (intervalId) { clearInterval(intervalId); intervalId = null; }
          isPlaying = false;
          playBtn.innerHTML = '<i class="fas fa-play"></i>';
          loadTrack(idx);
          isPlaying = true;
          playBtn.innerHTML = '<i class="fas fa-pause"></i>';
          progress = 0;
          progressFill.style.width = '0%';
          currentTimeSpan.textContent = '0:00';
          startProgress();
        });

        const downloadBtn = item.querySelector('.download-item-btn');
        downloadBtn.addEventListener('click', function(e) {
          e.stopPropagation();
          downloadTrack(index);
        });

        container.appendChild(item);
      });
    }

    playBtn.addEventListener('click', togglePlay);
    nextBtn.addEventListener('click', nextTrack);
    prevBtn.addEventListener('click', prevTrack);

    progressBar.addEventListener('click', function(e) {
      const rect = this.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const percent = (clickX / rect.width) * 100;
      progress = Math.min(100, Math.max(0, percent));
      progressFill.style.width = progress + '%';
      const totalSecs = 204;
      const currentSecs = (progress / 100) * totalSecs;
      currentTimeSpan.textContent = formatTime(currentSecs);
    });

    downloadTrackBtn.addEventListener('click', function() {
      downloadTrack(currentIndex);
    });

    downloadAllBtn.addEventListener('click', downloadAllTracks);
    downloadAllBtnFooter.addEventListener('click', downloadAllTracks);

    function init() {
      renderPlaylist();
      loadTrack(0);
      isPlaying = false;
      playBtn.innerHTML = '<i class="fas fa-play"></i>';
      if (intervalId) { clearInterval(intervalId); intervalId = null; }
      progress = 0;
      progressFill.style.width = '0%';
      currentTimeSpan.textContent = '0:00';
      updateTrackUI(0);
    }

    init();

    document.addEventListener('keydown', (e) => {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
      if (e.code === 'Space') {
        e.preventDefault();
        togglePlay();
      }
    });

  })();
</script>

</body>
</html>