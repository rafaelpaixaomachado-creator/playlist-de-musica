<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🎵 SoulWave · Player & Playlists</title>
  <!-- Font Awesome para ícones -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    }

    body {
      background: linear-gradient(145deg, #0b0e14 0%, #1a1f2b 100%);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 2rem 1rem;
    }

    /* card principal - centralizado */
    .music-app {
      max-width: 880px;
      width: 100%;
      background: rgba(22, 28, 40, 0.7);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-radius: 2.5rem;
      padding: 2rem 2rem 2rem 2rem;
      box-shadow: 0 25px 50px -10px rgba(0, 0, 0, 0.8), inset 0 1px 1px rgba(255, 255, 255, 0.06);
      border: 1px solid rgba(255, 255, 255, 0.04);
      transition: all 0.2s ease;
    }

    /* cabeçalho */
    .app-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
    }

    .app-header h1 {
      color: #f0f3fa;
      font-weight: 600;
      font-size: 1.8rem;
      letter-spacing: -0.5px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .app-header h1 i {
      color: #b388ff;
      font-size: 1.9rem;
    }

    .playlist-badge {
      background: rgba(179, 136, 255, 0.15);
      padding: 0.4rem 1.2rem;
      border-radius: 40px;
      color: #c9b0ff;
      font-size: 0.85rem;
      font-weight: 500;
      border: 1px solid rgba(179, 136, 255, 0.2);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .playlist-badge i {
      font-size: 0.8rem;
      color: #b388ff;
    }

    /* player principal */
    .player-card {
      background: rgba(12, 16, 24, 0.6);
      border-radius: 2rem;
      padding: 1.8rem 1.8rem 1.5rem;
      backdrop-filter: blur(4px);
      border: 1px solid rgba(255, 255, 255, 0.03);
      margin-bottom: 2.2rem;
      transition: 0.2s;
    }

    .now-playing {
      display: flex;
      align-items: center;
      gap: 1.4rem;
      flex-wrap: wrap;
    }

    .cover-art {
      width: 80px;
      height: 80px;
      border-radius: 20px;
      background: linear-gradient(135deg, #3d2c5e, #1f1b2e);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.8rem;
      color: #c9b0ff;
      box-shadow: 0 12px 20px -8px rgba(0, 0, 0, 0.6);
      flex-shrink: 0;
      border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .track-info {
      flex: 1;
      min-width: 160px;
    }

    .track-info .title {
      color: #f0f3fa;
      font-weight: 600;
      font-size: 1.3rem;
      letter-spacing: -0.3px;
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .track-info .title .fav {
      color: #ff7eb3;
      font-size: 0.9rem;
      opacity: 0.8;
    }

    .track-info .artist {
      color: #9aa4bf;
      font-size: 0.95rem;
      margin-top: 4px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .track-info .artist i {
      color: #5f6b89;
      font-size: 0.7rem;
    }

    .player-controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 1.5rem;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .control-buttons {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .control-buttons button {
      background: transparent;
      border: none;
      color: #c8d0e6;
      font-size: 1.5rem;
      width: 44px;
      height: 44px;
      border-radius: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: 0.2s;
      cursor: pointer;
      background: rgba(255, 255, 255, 0.02);
    }

    .control-buttons button:hover {
      background: rgba(179, 136, 255, 0.12);
      color: #e4defa;
      transform: scale(1.02);
    }

    .control-buttons .play-btn {
      background: #b388ff;
      color: #0b0e14;
      width: 54px;
      height: 54px;
      font-size: 1.8rem;
      box-shadow: 0 8px 18px rgba(179, 136, 255, 0.25);
    }

    .control-buttons .play-btn:hover {
      background: #c9aeff;
      transform: scale(1.04);
      box-shadow: 0 8px 22px rgba(179, 136, 255, 0.4);
    }

    .progress-area {
      flex: 2;
      min-width: 140px;
      display: flex;
      align-items: center;
      gap: 0.8rem;
    }

    .progress-area span {
      color: #8d99b5;
      font-size: 0.8rem;
      font-weight: 500;
      letter-spacing: 0.3px;
    }

    .progress-bar {
      flex: 1;
      height: 4px;
      background: #2d3445;
      border-radius: 10px;
      cursor: pointer;
      position: relative;
    }

    .progress-fill {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #b388ff, #d4b8ff);
      border-radius: 10px;
      transition: width 0.1s linear;
    }

    /* playlist */
    .playlist-section {
      margin-top: 1rem;
    }

    .playlist-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.2rem;
    }

    .playlist-header h3 {
      color: #d3dcef;
      font-weight: 500;
      font-size: 1.1rem;
      letter-spacing: 0.3px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .playlist-header h3 i {
      color: #b388ff;
      font-size: 1rem;
    }

    .playlist-header .count {
      background: #262e3e;
      padding: 0.2rem 0.9rem;
      border-radius: 40px;
      color: #a8b5d4;
      font-size: 0.75rem;
      font-weight: 500;
    }

    .playlist-items {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      max-height: 360px;
      overflow-y: auto;
      padding-right: 6px;
    }

    .playlist-items::-webkit-scrollbar {
      width: 4px;
    }

    .playlist-items::-webkit-scrollbar-track {
      background: #1c222f;
      border-radius: 10px;
    }

    .playlist-items::-webkit-scrollbar-thumb {
      background: #4e5a77;
      border-radius: 10px;
    }

    .track-item {
      display: flex;
      align-items: center;
      padding: 0.8rem 1rem;
      border-radius: 1.2rem;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid transparent;
      transition: 0.2s;
      cursor: pointer;
      gap: 1rem;
    }

    .track-item:hover {
      background: rgba(179, 136, 255, 0.06);
      border-color: rgba(179, 136, 255, 0.08);
    }

    .track-item.active {
      background: rgba(179, 136, 255, 0.10);
      border-color: rgba(179, 136, 255, 0.18);
    }

    .track-item .index {
      color: #5f6b89;
      font-weight: 500;
      font-size: 0.8rem;
      width: 24px;
      text-align: center;
    }

    .track-item .info {
      flex: 1;
    }

    .track-item .info .name {
      color: #eef2fc;
      font-weight: 500;
      font-size: 0.98rem;
    }

    .track-item .info .artist-name {
      color: #7f8aa8;
      font-size: 0.8rem;
    }

    .track-item .duration {
      color: #5f6b89;
      font-size: 0.8rem;
      background: #1c222f;
      padding: 0.2rem 0.7rem;
      border-radius: 40px;
    }

    .track-item .play-icon {
      color: #b388ff;
      opacity: 0;
      transition: 0.2s;
    }

    .track-item:hover .play-icon {
      opacity: 1;
    }

    .track-item.active .play-icon {
      opacity: 1;
      color: #d4b8ff;
    }

    .footer-actions {
      margin-top: 1.5rem;
      display: flex;
      justify-content: flex-end;
      color: #5f6b89;
      font-size: 0.8rem;
      border-top: 1px solid rgba(255, 255, 255, 0.03);
      padding-top: 1.2rem;
      gap: 1.5rem;
    }

    .footer-actions i {
      margin-right: 6px;
      color: #6b7a9c;
    }

    @media (max-width: 600px) {
      .music-app {
        padding: 1.5rem;
      }
      .now-playing {
        flex-direction: column;
        align-items: flex-start;
      }
      .player-controls {
        flex-direction: column;
        align-items: stretch;
      }
      .control-buttons {
        justify-content: center;
      }
      .progress-area {
        width: 100%;
      }
      .track-item {
        padding: 0.6rem 0.8rem;
      }
    }
  </style>
</head>
<body>

<div class="music-app">
  <!-- cabeçalho -->
  <div class="app-header">
    <h1><i class="fas fa-headphones-simple"></i> SoulWave</h1>
    <div class="playlist-badge">
      <i class="fas fa-list-ul"></i> 6 faixas
    </div>
  </div>

  <!-- player card -->
  <div class="player-card" id="playerCard">
    <div class="now-playing">
      <div class="cover-art" id="coverArt">
        <i class="fas fa-music"></i>
      </div>
      <div class="track-info">
        <div class="title" id="currentTitle">
          <span>Nightfall</span>
          <span class="fav"><i class="fas fa-heart"></i></span>
        </div>
        <div class="artist" id="currentArtist">
          <i class="fas fa-user-circle"></i> Aurora Lane
        </div>
      </div>
    </div>

    <div class="player-controls">
      <div class="control-buttons">
        <button id="prevBtn"><i class="fas fa-step-backward"></i></button>
        <button class="play-btn" id="playBtn"><i class="fas fa-play"></i></button>
        <button id="nextBtn"><i class="fas fa-step-forward"></i></button>
      </div>
      <div class="progress-area">
        <span id="currentTime">0:00</span>
        <div class="progress-bar" id="progressBar">
          <div class="progress-fill" id="progressFill"></div>
        </div>
        <span id="totalDuration">3:24</span>
      </div>
    </div>
  </div>

  <!-- playlist -->
  <div class="playlist-section">
    <div class="playlist-header">
      <h3><i class="fas fa-layer-group"></i> Playlist · Vibes</h3>
      <span class="count"><i class="far fa-clock"></i> 21 min</span>
    </div>

    <div class="playlist-items" id="playlistContainer">
      <!-- itens serão inseridos via JS -->
    </div>
  </div>

  <div class="footer-actions">
    <span><i class="fas fa-shuffle"></i> aleatório</span>
    <span><i class="fas fa-repeat"></i> repetir</span>
  </div>
</div>

<script>
  (function() {
    // ---------- DADOS DAS MÚSICAS ----------
    const playlist = [
      { id: 0, title: 'Nightfall', artist: 'Aurora Lane', duration: '3:24', cover: '🌙' },
      { id: 1, title: 'Echoes', artist: 'Mira Solis', duration: '4:12', cover: '🌊' },
      { id: 2, title: 'Velvet Dreams', artist: 'Noir & Ivory', duration: '3:48', cover: '🌆' },
      { id: 3, title: 'Pulse', artist: 'Neon Grid', duration: '2:59', cover: '⚡' },
      { id: 4, title: 'Solstice', artist: 'Aurora Lane', duration: '4:01', cover: '☀️' },
      { id: 5, title: 'Lunar Tide', artist: 'Stellar Drift', duration: '3:36', cover: '🌊' }
    ];

    // ---------- ELEMENTOS DOM ----------
    const playlistContainer = document.getElementById('playlistContainer');
    const playBtn = document.getElementById('playBtn');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');
    const progressFill = document.getElementById('progressFill');
    const progressBar = document.getElementById('progressBar');
    const currentTimeSpan = document.getElementById('currentTime');
    const totalDurationSpan = document.getElementById('totalDuration');
    const currentTitle = document.getElementById('currentTitle');
    const currentArtist = document.getElementById('currentArtist');
    const coverArt = document.getElementById('coverArt');

    // ---------- ESTADO ----------
    let currentIndex = 0;
    let isPlaying = false;
    let progress = 0; // 0–100
    let intervalId = null;

    // ---------- FUNÇÕES AUXILIARES ----------
    function formatTime(seconds) {
      const mins = Math.floor(seconds / 60);
      const secs = Math.floor(seconds % 60);
      return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
    }

    // Atualiza a interface com a música atual (sem alterar progresso)
    function updateTrackUI(index) {
      const track = playlist[index];
      if (!track) return;

      // título e artista
      currentTitle.innerHTML = `<span>${track.title}</span> <span class="fav"><i class="fas fa-heart"></i></span>`;
      currentArtist.innerHTML = `<i class="fas fa-user-circle"></i> ${track.artist}`;
      coverArt.innerHTML = `<span style="font-size:2.6rem;">${track.cover || '🎵'}</span>`;
      
      // duração total
      totalDurationSpan.textContent = track.duration;

      // destaque ativo na playlist
      document.querySelectorAll('.track-item').forEach((el, idx) => {
        el.classList.toggle('active', idx === index);
      });

      // scroll suave para o item ativo
      const activeItem = document.querySelector('.track-item.active');
      if (activeItem) {
        activeItem.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    }

    // Carrega a música (index) e para reprodução
    function loadTrack(index) {
      if (index < 0) index = 0;
      if (index >= playlist.length) index = playlist.length - 1;
      currentIndex = index;
      // reseta progresso
      progress = 0;
      progressFill.style.width = '0%';
      currentTimeSpan.textContent = '0:00';
      updateTrackUI(currentIndex);
      // se estava tocando, continua tocando (reinicia)
      if (isPlaying) {
        clearInterval(intervalId);
        startProgress();
      } else {
        // se parado, apenas atualiza
        if (intervalId) clearInterval(intervalId);
        intervalId = null;
      }
      // atualiza ícone do play
      playBtn.innerHTML = isPlaying ? '<i class="fas fa-pause"></i>' : '<i class="fas fa-play"></i>';
    }

    // Inicia a barra de progresso (simulação)
    function startProgress() {
      if (intervalId) clearInterval(intervalId);
      intervalId = setInterval(() => {
        if (progress >= 100) {
          // fim da música -> próximo
          clearInterval(intervalId);
          intervalId = null;
          isPlaying = false;
          playBtn.innerHTML = '<i class="fas fa-play"></i>';
          // Avança para a próxima faixa (ou para o início se for a última)
          const next = (currentIndex + 1) % playlist.length;
          loadTrack(next);
          // se o loop estiver ativo, tocar automaticamente
          // (comportamento simples: ao chegar no fim, para)
          // mas vamos tocar automaticamente a próxima se houver
          if (next !== 0 || currentIndex === playlist.length-1) {
            // só toca automaticamente se não for a última? vamos tocar sempre
            // mas se for a última, para. 
            if (currentIndex === playlist.length-1) {
              // para no final
              isPlaying = false;
              playBtn.innerHTML = '<i class="fas fa-play"></i>';
              progress = 0;
              progressFill.style.width = '0%';
              currentTimeSpan.textContent = '0:00';
              return;
            }
          }
          // toca a próxima automaticamente
          isPlaying = true;
          playBtn.innerHTML = '<i class="fas fa-pause"></i>';
          // progresso já resetado em loadTrack, mas loadTrack reseta progress
          // vamos garantir que o progresso comece do zero
          progress = 0;
          progressFill.style.width = '0%';
          currentTimeSpan.textContent = '0:00';
          // e reinicia o intervalo
          startProgress();
          return;
        }
        progress += 1.2; // velocidade
        if (progress > 100) progress = 100;
        progressFill.style.width = progress + '%';
        // Atualiza o tempo atual baseado na duração (simulação)
        const totalSecs = 204; // 3:24 base, mas usaremos duração aproximada
        const currentSecs = (progress / 100) * totalSecs;
        currentTimeSpan.textContent = formatTime(currentSecs);
      }, 300);
    }

    // Toggle play/pause
    function togglePlay() {
      if (isPlaying) {
        // pausar
        clearInterval(intervalId);
        intervalId = null;
        isPlaying = false;
        playBtn.innerHTML = '<i class="fas fa-play"></i>';
      } else {
        // tocar
        isPlaying = true;
        playBtn.innerHTML = '<i class="fas fa-pause"></i>';
        if (progress >= 100) {
          // se já terminou, recomeça
          progress = 0;
          progressFill.style.width = '0%';
          currentTimeSpan.textContent = '0:00';
        }
        startProgress();
      }
    }

    // Próxima faixa
    function nextTrack() {
      const nextIndex = (currentIndex + 1) % playlist.length;
      // para a simulação
      if (intervalId) {
        clearInterval(intervalId);
        intervalId = null;
      }
      isPlaying = false;
      playBtn.innerHTML = '<i class="fas fa-play"></i>';
      loadTrack(nextIndex);
      // se quiser tocar automaticamente ao clicar em next, descomente:
      // mas é melhor manter o comportamento: next carrega e fica pausado.
      // vamos manter pausado.
    }

    // Faixa anterior
    function prevTrack() {
      const prevIndex = (currentIndex - 1 + playlist.length) % playlist.length;
      if (intervalId) {
        clearInterval(intervalId);
        intervalId = null;
      }
      isPlaying = false;
      playBtn.innerHTML = '<i class="fas fa-play"></i>';
      loadTrack(prevIndex);
    }

    // ---------- RENDERIZAR PLAYLIST ----------
    function renderPlaylist() {
      playlistContainer.innerHTML = '';
      playlist.forEach((track, index) => {
        const item = document.createElement('div');
        item.className = `track-item ${index === currentIndex ? 'active' : ''}`;
        item.dataset.index = index;

        item.innerHTML = `
          <span class="index">${index + 1}</span>
          <div class="info">
            <div class="name">${track.title}</div>
            <div class="artist-name">${track.artist}</div>
          </div>
          <span class="duration">${track.duration}</span>
          <span class="play-icon"><i class="fas fa-play-circle"></i></span>
        `;

        item.addEventListener('click', function(e) {
          const idx = parseInt(this.dataset.index);
          if (intervalId) {
            clearInterval(intervalId);
            intervalId = null;
          }
          isPlaying = false;
          playBtn.innerHTML = '<i class="fas fa-play"></i>';
          loadTrack(idx);
          // tocar automaticamente ao clicar?
          // Vamos tocar ao clicar (como esperado)
          isPlaying = true;
          playBtn.innerHTML = '<i class="fas fa-pause"></i>';
          progress = 0;
          progressFill.style.width = '0%';
          currentTimeSpan.textContent = '0:00';
          startProgress();
        });

        playlistContainer.appendChild(item);
      });
    }

    // ---------- EVENT LISTENERS ----------
    playBtn.addEventListener('click', togglePlay);
    nextBtn.addEventListener('click', nextTrack);
    prevBtn.addEventListener('click', prevTrack);

    // Clique na barra de progresso (seek)
    progressBar.addEventListener('click', function(e) {
      const rect = this.getBoundingClientRect();
      const clickX = e.clientX - rect.left;
      const percent = (clickX / rect.width) * 100;
      progress = Math.min(100, Math.max(0, percent));
      progressFill.style.width = progress + '%';
      const totalSecs = 204; // duração aproximada
      const currentSecs = (progress / 100) * totalSecs;
      currentTimeSpan.textContent = formatTime(currentSecs);
    });

    // ---------- INICIALIZAÇÃO ----------
    function init() {
      renderPlaylist();
      loadTrack(0);
      // não tocar automaticamente
      isPlaying = false;
      playBtn.innerHTML = '<i class="fas fa-play"></i>';
      if (intervalId) {
        clearInterval(intervalId);
        intervalId = null;
      }
      progress = 0;
      progressFill.style.width = '0%';
      currentTimeSpan.textContent = '0:00';
      updateTrackUI(0);
    }

    init();

    // Atualizar ícone do coração (só estético)
    // E suporte para teclas (espaço)
    document.addEventListener('keydown', (e) => {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
      if (e.code === 'Space') {
        e.preventDefault();
        togglePlay();
      }
    });

  })();
</script>
</body>
</html>